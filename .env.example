# ==========================================
# Poland Macro Crisis Radar — Szablon Konfiguracji
# Skopiuj ten plik do .env i uzupełnij własne wartości:
# cp .env.example .env
# ==========================================

# Port serwera HTTP
PORT=8000

# Autoryzacja Administratora
ADMIN_USER=admin
ADMIN_PASSWORD=twoje_bezpieczne_haslo

# Harmonogram pobierania danych rynkowych (Pn-Pt o 18:30)
CRON_SCHEDULE=30 18 * * 1-5

# Liczba sesji historycznych przy starcie (domyślnie 250 - pełny rok giełdowy)
BACKFILL_DAYS=250

# Cykliczny backup bazy na e-mail
EMAIL_BACKUP_ENABLED=false
BACKUP_EMAIL_TO=twoj@email.pl
EMAIL_BACKUP_FROM="Macro Radar Backup <backup@twojadomena.pl>"
EMAIL_BACKUP_SCHEDULE=0 3 * * 0

# Serwer pocztowy SMTP
SMTP_HOST=smtp.twojserwer.pl
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=login@twojadomena.pl
SMTP_PASS=haslo_smtp

# Raport Dzienny na E-mail (HTML Digest po sesji)
EMAIL_DIGEST_ENABLED=true
EMAIL_DIGEST_TO=twoj@email.pl
EMAIL_DIGEST_SCHEDULE=35 18 * * 1-5

# Natychmiastowe Powiadomienia Push (ntfy.sh)
NTFY_ENABLED=true
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=radar-makro-pl-twoj-unikalny-kanal
APP_URL=https://watch.mikrus.dev
